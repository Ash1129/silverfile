# Copy to .env and `chmod 600 .env`. .env is gitignored and never copied into the Docker image.
# Never commit a real key; tests/security/test_sec_structure.py fails if one is tracked.

# --- Model access. Blank = offline mode: scripted intake parsing, fixture-based document
# extraction and rule-only review.
ANTHROPIC_API_KEY=
# Models (defaults shown). The reviewer must differ from the worker model.
SILVERFILE_INTAKE_MODEL=claude-haiku-5-5
SILVERFILE_EXTRACTION_MODEL=claude-sonnet-5-5
SILVERFILE_REVIEW_MODEL=claude-opus-5-5

# --- Data and encryption at rest. Checkpoints, uploads and the index are encrypted with a
# key derived from SILVERFILE_DATA_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Blank in a development checkout = a key is generated into the data directory (convenient,
# not protective). With SILVERFILE_ENV=production a blank key stops the server.
# Rotation: put the new key first, the old one after a comma.
SILVERFILE_DATA_KEY=
SILVERFILE_ENV=
SILVERFILE_DATA_DIR=data/runtime
# Returns not finished and untouched for this many days are deleted, uploads included.
SILVERFILE_RETENTION_DAYS=30

# --- Staff accounts. The first admin is created from these on start if no staff account exists;
# add more with `python run.py staff add <name> --role preparer|clerk|admin`.
SILVERFILE_ADMIN_USER=
SILVERFILE_ADMIN_PASSWORD=

# --- Limits. Model calls per return per minute, and total tokens one return may spend.
SILVERFILE_LLM_CALLS_PER_MINUTE=20
SILVERFILE_MAX_TOKENS_PER_RETURN=250000
SILVERFILE_MAX_UPLOAD_MB=10

# Set to 1 to call tax_math functions in-process instead of over MCP stdio (tests only).
SILVERFILE_TAXMATH_DIRECT=0

# Shared copies only (the Dockerfile sets both). SILVERFILE_SEED_DEMO=1 seeds six demo returns on
# first start. SILVERFILE_REQUIRE_KEY=1, with ANTHROPIC_API_KEY blank, asks each visitor for their
# own Anthropic key and runs the live models on it; leave it unset locally.
SILVERFILE_SEED_DEMO=
SILVERFILE_REQUIRE_KEY=
