y="82" width="135" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="simpler" name="Simpler start"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="simpler-root"/><mxCell id="simpler-layer" parent="simpler-root"/><UserObject id="simpler-start" label="&lt;b&gt;1. You paste in an example&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Trigger · Claude, by hand&lt;/font&gt;" tooltip="What happens: Work starts the way it does today.&#10;&#10;Why it's here: You said you'll start it yourself.&#10;&#10;Passes on: The item to work on." step="1" kind="Start" name="You paste in an example" runs-in="Claude, by hand" model-or-method="Manual start" how-it-works="Runs only when a person starts it." what-happens="Work starts the way it does today." why-its-here="You said you'll start it yourself." what-it-passes-on="The item to work on." next="step 2, One well-written prompt"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#13201b;spacing=8;fillColor=#1c6650;strokeColor=#1c6650;fontColor=#ffffff;" vertex="1" parent="simpler-layer"><mxGeometry x="50" y="160" width="200" height="110" as="geometry"/></mxCell></UserObject><UserObject id="simpler-prompt" label="&lt;b&gt;2. One well-written prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AI · Claude, examples attached · Sonnet 5.5&lt;/font&gt;" tooltip="What happens: A single prompt with good examples attached does the whole job in one go.&#10;&#10;Why it's here: A single prompt is often enough, and its failures show you exactly which step needs its own treatment.&#10;&#10;Passes on: A draft for you to check." step="2" kind="AI step" name="One well-written prompt" runs-in="Claude, examples attached" model-or-method="Claude Sonnet 5.5" why-this-model="A balanced model handles most judgement steps well at a reasonable cost per run." how-to-start="Build the first version on Claude Opus 5.5. Switch to Claude Sonnet 5.5 once it matches that baseline on your test examples. If Claude Opus 5.5 itself falls short on the hardest steps, try Claude Fable 5.1; it requires Anthropic to keep data for 30 days, so it is unavailable under zero data retention." alternative="Open-weight alternative: for example Kimi K2.6, GLM-5 or DeepSeek-V4-Pro (leading open-weight models in October 2026)." what-happens="A single prompt with good examples attached does the whole job in one go." why-its-here="A single prompt is often enough, and its failures show you exactly which step needs its own treatment." what-it-passes-on="A draft for you to check." next="step 3, You check the result" rules="S4: if AI workflow you start yourself, then Start with one well-written prompt and no extra tools."><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#13201b;spacing=8;fillColor=#fdebd2;strokeColor=#e0802a;strokeWidth=2;" vertex="1" parent="simpler-layer"><mxGeometry x="360" y="160" width="200" height="110" as="geometry"/></mxCell></UserObject><UserObject id="simpler-approve" label="&lt;b&gt;3. You check the result&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Person · Person&lt;/font&gt;" tooltip="What happens: You compare the draft with what good looks like, and note what the instructions need to say.&#10;&#10;Why it's here: This teaches you what to automate before you pay to automate it.&#10;&#10;Passes on: Approved results." step="3" kind="Person" name="You check the result" runs-in="Person" what-happens="You compare the draft with what good looks like, and note what the instructions need to say." why-its-here="This teaches you what to automate before you pay to automate it." what-it-passes-on="Approved results." next="step 4, Result is ready" rules="S4: if AI workflow you start yourself, then Start with one well-written prompt and no extra tools."><mxCell style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#13201b;spacing=8;fillColor=#fde4e1;strokeColor=#cf4a42;strokeWidth=2;dashed=1;" vertex="1" parent="simpler-layer"><mxGeometry x="670" y="160" width="200" height="110" as="geometry"/></mxCell></UserObject><UserObject id="simpler-end" label="&lt;b&gt;4. Result is ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Finish · Delivered output&lt;/font&gt;" tooltip="What happens: The result goes out, exactly as it would in the full design.&#10;&#10;Why it's here: The outcome doesn't change; only how much is automated.&#10;&#10;Passes on: Nothing further. Note what went wrong: it shapes the full design." step="4" kind="Finish" name="Result is ready" runs-in="Delivered output" what-happens="The result goes out, exactly as it would in the full design." why-its-here="The outcome doesn't change; only how much is automated." what-it-passes-on="Nothing further. Note what went wrong: it shapes the full design."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#13201b;spacing=8;fillColor=#1c6650;strokeColor=#1c6650;fontColor=#ffffff;" vertex="1" parent="simpler-layer"><mxGeometry x="980" y="160" width="200" height="110" as="geometry"/></mxCell></UserObject><mxCell id="simpler-e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4d5b55;strokeColor=#7f8d87;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="simpler-layer" source="simpler-start" target="simpler-prompt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="simpler-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4d5b55;strokeColor=#7f8d87;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="simpler-layer" source="simpler-prompt" target="simpler-approve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="simpler-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4d5b55;strokeColor=#7f8d87;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="simpler-layer" source="simpler-approve" target="simpler-end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="simpler-title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Prepare draft Form 1040-SR returns with source provenance for human review&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4d5b55&quot;&gt;One good prompt · Simpler start&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#13201b;" vertex="1" parent="simpler-layer"><mxGeometry x="40" y="20" width="900" height="50" as="geometry"/></mxCell><mxCell id="simpler-key-start" value="Start / finish" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#13201b;spacing=8;fillColor=#1c6650;strokeColor=#1c6650;fontColor=#ffffff;" vertex="1" parent="simpler-layer"><mxGeometry x="40" y="82" width="135" height="34" as="geometry"/></mxCell><mxCell id="simpler-key-ai" value="AI step" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#13201b;spacing=8;fillColor=#fdebd2;strokeColor=#e0802a;" vertex="1" parent="simpler-layer"><mxGeometry x="190" y="82" width="135" height="34" as="geometry"/></mxCell><mxCell id="simpler-key-human" value="Person" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#13201b;spacing=8;fillColor=#fde4e1;strokeColor=#cf4a42;dashed=1;" vertex="1" parent="simpler-layer"><mxGeometry x="340" y="82" width="135" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>